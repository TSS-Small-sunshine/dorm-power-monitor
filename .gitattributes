# =============================================================================
# 换行符策略 —— 为什么必须显式写下来
# =============================================================================
# 这个项目在 Windows 上开发、在 Linux 上运行（Docker / VPS）。
# shell 脚本一旦带 CRLF 进仓库，Linux 上会以两种经典方式炸，而且报错完全
# 看不出是换行符问题：
#
#   · docker-entrypoint.sh → exec /app/docker-entrypoint.sh: no such file or directory
#   · install.sh           → /usr/bin/env: 'bash\r': No such file or directory
#   · systemd 单元         → 服务起不来，ExecStart 解析出奇怪的值
#
# 所以这里钉死：**要在 Linux 上执行的文件一律 LF**，不管你在哪台机器上改。
# =============================================================================

# 其余文件交给 git 自动判断（文本归一化，二进制不动）
* text=auto

# —— 必须在 Linux 上执行的文件：强制 LF ——
*.sh                text eol=lf
Dockerfile          text eol=lf
docker-compose.yml  text eol=lf
.dockerignore       text eol=lf
*.service           text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf

# —— 二进制：别当文本处理 ——
*.png    binary
*.jpg    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.db     binary
