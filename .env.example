# =============================================================================
# StarWatt 星瓦 —— 环境变量模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 `.env`：   cp .env.example .env
#   2. 给 `.env` 加权限保护：   chmod 600 .env
#   3. 启动服务，访问 http://<host>:<port>/  → 自动进入 OOBE 配置向导
#
# ⚠️ 本文件**只保留 4 项「DB 打开前必需」的启动配置**（Q15）。
#
#    其余所有配置项（学校 openid / 飞书凭据 / 推送开关 / 告警阈值 /
#    抓取节流 / 认证策略 / 日志级别 …）**全部在 WebUI 里改**，
#    存储于 SQLite 的 meta 表，无需重启即可生效。
#
#    详见 docs/REWRITE_PLAN.md §2.8「配置注册表」。
#
# 安全提示：
#   - `.env` 已在 .gitignore 里，**永远不要**提交到 git
#   - 生产环境用 systemd `EnvironmentFile=` 加载，避免放在代码目录
# =============================================================================


# -----------------------------------------------------------------------------
# 【1/4】数据库文件路径
# -----------------------------------------------------------------------------
# 可以写相对路径（按**项目根**解析，不跟随 cwd）或绝对路径。
# 生产建议放在服务用户可写的目录：
#     DB_PATH=/var/lib/dorm-power-monitor/records.db
DB_PATH=./records.db


# -----------------------------------------------------------------------------
# 【2/4】数据目录
# -----------------------------------------------------------------------------
# DB / 备份 / 日志的根目录。留空 = 项目根。
# 生产建议：DORM_DATA_DIR=/var/lib/dorm-power-monitor
DORM_DATA_DIR=


# -----------------------------------------------------------------------------
# 【3/4】HTTP 监听端口
# -----------------------------------------------------------------------------
# gunicorn 与 Flask 共用此端口。反代（nginx / Caddy）指向 127.0.0.1:<port>。
FLASK_PORT=5000


# -----------------------------------------------------------------------------
# 【4/4】Flask 会话签名密钥
# -----------------------------------------------------------------------------
# 🔒 同时用于派生「配置中心里 secrets 的 AES-GCM 加密密钥」。
#
# 生成方式：
#     python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ 丢失后果：配置中心里所有加密存储的 secrets（openid / 飞书凭据 …）
#    将**无法解密**，需要重新填写。请务必备份。
#
# 留空时程序会**自动生成并写回 .env**（首次启动）。
FLASK_SECRET_KEY=
