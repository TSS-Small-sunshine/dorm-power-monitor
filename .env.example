# =============================================================================
# 宿舍电量监控 (dorm-power-monitor) — 环境变量模板
# =============================================================================
# 使用方法：
#   1. 复制本文件为 `.env`：
#        cp .env.example .env
#   2. 编辑 `.env`，把每项 [REQUIRED] 替换为真实值
#   3. 给 `.env` 加上权限保护：
#        chmod 600 .env
#
# 安全提示：
#   - `.env` 已在 .gitignore 里，**永远不要**把它提交到 git
#   - 所有 `SECRET` / `TOKEN` / `KEY` / `OPENID` 都是凭据，等同于密码
#   - 生产环境用 systemd `EnvironmentFile=` 加载，避免放在代码目录
# =============================================================================


# -----------------------------------------------------------------------------
# 【Feishu 群机器人 — 告警推送】
# -----------------------------------------------------------------------------
# 群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 webhook URL
# 形如：https://open.feishu.cn/open-apis/bot/v2/hook/<random-id>
#
# 留空：告警会打印到 stdout（适合开发 / 无机器人环境）。
# [REQUIRED for alerts]
FEISHU_WEBHOOK=

# 只有在群机器人设置里勾选了"签名校验"才需要：
# 同一个机器人配置页 → "签名校验" → 复制 secret。
# [OPTIONAL]
FEISHU_SECRET=


# -----------------------------------------------------------------------------
# 【Feishu 私聊机器人应用 — 接收 /状态 /电表 等命令】
# -----------------------------------------------------------------------------
# 飞书开放平台 https://open.feishu.cn/app → 创建企业自建应用 → 凭证与基础信息
# 全部留空也能跑：url_verification 探活会通过，但 slash 命令不会回复。
# [OPTIONAL] 三项必须同时设置才生效
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# 事件订阅页 → Verification Token（事件签名校验的可选项）
# 留空：跳过签名校验（开发环境）
# [OPTIONAL]
FEISHU_VERIFICATION_TOKEN=

# 事件订阅页 → Encrypt Key（仅当开启"加密"模式才需要）
# 留空：明文事件即可
# [OPTIONAL]
FEISHU_ENCRYPT_KEY=


# -----------------------------------------------------------------------------
# 【宿舍电费系统 — 抓取器】
# -----------------------------------------------------------------------------
# DORM_OPENID 是你从宿舍电费 H5 页面 URL 拿到的 openid 查询参数。
# 打开微信 → 宿舍电费小程序 → 复制内嵌浏览器的 URL，取 ?openid= 后面的值。
# 等同于密码，绝对不要泄露、不要提交到 git。
# [REQUIRED]
DORM_OPENID=

# 电费服务的基础 URL。默认绑定福建省某高校（ybhqcz.fjny.edu.cn）。
# 适配其他学校必须改这个。
# 留空 = 用默认值。
# [OPTIONAL — 但生产必须改]
DORM_BASE_URL=http://ybhqcz.fjny.edu.cn

# 房间的 UUID（数据 API 期望的 roomId）。
# 留空 = 每次抓取时自动从 finduser 页面的 <input id="roomId"> 解析。
# 显式设置可以跳过那一次额外请求，节省 100-200ms。
# [OPTIONAL]
DORM_ROOM_ID=


# -----------------------------------------------------------------------------
# 【本地存储 — SQLite】
# -----------------------------------------------------------------------------
# SQLite 文件的绝对路径。
# 开发：./records.db（项目根）
# 生产：/var/lib/dorm-power-monitor/records.db（需要 www-data 可写）
# [OPTIONAL]
DB_PATH=./records.db

# 抓取间隔（分钟）。仅作参考值，不会自动调整 cron；保持与 deploy/dorm-cron.txt 同步。
# [OPTIONAL]
SCRAPE_INTERVAL_MINUTES=60


# -----------------------------------------------------------------------------
# 【Flask 仪表盘】
# -----------------------------------------------------------------------------
# 监听地址。生产保持 127.0.0.1，让 nginx 在前面反代。
# [OPTIONAL]
FLASK_HOST=127.0.0.1

# 监听端口。确保 nginx 配置里的 proxy_pass 也指这里。
# [OPTIONAL]
FLASK_PORT=5000

# 调试模式：1 = 开启自动 reload，0 = 生产模式。
# ⚠️ 生产环境永远用 0，否则会暴露栈追踪。
# [OPTIONAL]
FLASK_DEBUG=0
