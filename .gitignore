# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Tests
tests/legacy/
/_tmp_*.py
/_tmp_*.txt
/_tmp_*.zip

# 本地临时文件（调试输出 / 提交信息草稿 / 探针文件）
# 约定：以下划线开头、**只放在仓库根目录**、不放进任何包
#   ⚠️ 必须带前导 `/`（锚定根目录）：写成 `_*.py` 会连 `__init__.py`
#      一起忽略 —— 包初始化文件被静默丢弃，新克隆的仓库直接 import 失败。
/_*.txt
/_*.py
/_*.json


# OS
.DS_Store
Thumbs.db

# Build artifacts
*.zip
!archive/*.zip
backups/
dist/
build/

# IDE
.vscode/
.idea/

# Secrets (NEVER commit)
.env
.env.local
.github_pat
# Runtime data (never commit)
records.db
*.db-wal
*.db-shm
*.db-journal
tests/**/records.db
