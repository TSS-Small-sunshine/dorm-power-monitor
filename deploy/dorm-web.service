[Unit]
Description=StarWatt 星瓦 · 宿舍电量监控（gunicorn + 进程内调度）
After=network.target

[Service]
Type=simple
# `www-data` is the conventional nginx user on Debian/Ubuntu.  If you
# run a dedicated user instead, change this and the `ReadWritePaths=`
# entry below.  Use `User=root` ONLY as a last resort and document the
# reason -- the hardening directives below lose most of their value
# under root.
User=www-data
Group=www-data

WorkingDirectory=/opt/dorm-power-monitor
EnvironmentFile=-/opt/dorm-power-monitor/.env
# B2：gunicorn（workers=1 + preload_app=False）—— 抓取调度由
# gunicorn.conf.py 的 post_fork 在 worker 内启动（B3）。
# 旧写法 `python web.py`（Flask dev server）已废弃：reloader 会让调度器
# 启动两次，且 dev/prod 行为不一致。
ExecStart=/opt/dorm-power-monitor/.venv/bin/gunicorn \
            -c /opt/dorm-power-monitor/gunicorn.conf.py web:app

Restart=always
RestartSec=5

# --- hardening (per systemd.exec(5)) ---------------------------------
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute=true is intentionally OFF: some Python C
# extensions (numpy, lxml, ...) generate code at runtime and crash
# under MDE.  Leave it off unless you've audited the dependency tree.
SystemCallArchitectures=native
ReadWritePaths=/opt/dorm-power-monitor /var/lib/dorm-power-monitor

[Install]
WantedBy=multi-user.target
